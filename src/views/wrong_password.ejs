<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="./css/style.css" />
    <link rel="stylesheet" href="./css/tailwind.css" />
    <link rel="stylesheet" href="./css/responsive.css" />
    <title>Wrong Password</title>
  </head>
  <body>
    <div class="flex justify-center items-center h-dvh" style="height: 100dvh">
      <div class="totalBx">
        <h1 class="text-3xl font-bold">Wrong Password</h1>

        <p class="text-lg mt-4">
          The password you entered is incorrect. Please try again.
        </p>

        <div class="pt-5">
          <p class="pt-5">
            Don't have an account? <a class="su-link" href="/signup">SignUp</a>
          </p>
          <p class="mt-2">
            Already have an account?
            <a class="text-blue-500 hover:text-blue-800" href="/login">Login</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
